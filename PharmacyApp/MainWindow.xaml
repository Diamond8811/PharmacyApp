<Window x:Class="PharmacyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PharmacyApp"
        xmlns:vm="clr-namespace:PharmacyApp.ViewModels"
        xmlns:views="clr-namespace:PharmacyApp.Views"
        xmlns:conv="clr-namespace:PharmacyApp.Converters"
        mc:Ignorable="d"
        Title="Аптека" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate DataType="{x:Type vm:StaffViewModel}">
            <views:StaffView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DrugsViewModel}">
            <views:DrugsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeliveryViewModel}">
            <views:DeliveryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <views:AnalyticsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Аптека" Style="{StaticResource WindowTitleStyle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding CurrentEmployee.FullName}" Style="{StaticResource SecondaryTextStyle}"/>
                    <TextBlock Text="{Binding CurrentEmployee.RoleName}" Style="{StaticResource SecondaryTextStyle}"/>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                </StackPanel>

                <!-- Навигация -->
                <StackPanel>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,4"
                            Content="Продажи" Command="{Binding NavigateCommand}" CommandParameter="Продажи"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,4"
                            Content="Склад" Command="{Binding NavigateCommand}" CommandParameter="Склад"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,4"
                            Content="Поставки"
                            Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding NavigateCommand}" CommandParameter="Поставки"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,4"
                            Content="Справочники"
                            Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding NavigateCommand}" CommandParameter="Справочники"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,4"
                            Content="Сотрудники"
                            Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding NavigateCommand}" CommandParameter="Сотрудники"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,4"
                            Content="Отчёты"
                            Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding NavigateCommand}" CommandParameter="Отчёты"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,4"
                            Content="Аналитика"
                            Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding NavigateCommand}" CommandParameter="Аналитика"/>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                    <CheckBox Content="Тёмная тема" IsChecked="{Binding IsDarkTheme}" Margin="0,4"/>
                    <Button Style="{StaticResource DangerButtonStyle}" Margin="0,8,0,0"
                            Content="Выход" Command="{Binding LogoutCommand}"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <ContentControl x:Name="TransitionControl" Content="{Binding CurrentViewModel}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>
    </Grid>
</Window>