<UserControl x:Class="PharmacyApp.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PharmacyApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Продажи" Style="{StaticResource WindowTitleStyle}"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding CashierName}"/>
            </StackPanel>
            <Button Style="{StaticResource IconButtonStyle}" DockPanel.Dock="Right"
                    Command="{Binding LoadDrugsCommand}" ToolTip="Обновить список">
                <TextBlock Text="↻" FontSize="16" FontWeight="Bold"/>
            </Button>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Drugs}"
                          SelectedItem="{Binding SelectedDrug}"
                          DisplayMemberPath="Name"/>

                <TextBox Grid.Column="2" Text="{Binding QuantityToAdd, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="4" Style="{StaticResource AccentButtonStyle}"
                        Content="Добавить" Command="{Binding AddItemCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding DrugName}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="90"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal}" IsReadOnly="True" Width="110"/>
                    <DataGridTemplateColumn Header="" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DangerButtonStyle}"
                                        Content="Убрать"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Итого" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Margin="0,12,0,0" Text="{Binding Total, StringFormat=0.00 ₽}" Style="{StaticResource PriceStyle}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                Content="Очистить" Command="{Binding ClearCommand}"/>
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="Сохранить чек" Command="{Binding SaveSaleCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>