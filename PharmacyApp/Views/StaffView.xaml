<UserControl x:Class="PharmacyApp.Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PharmacyApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Сотрудники" Style="{StaticResource WindowTitleStyle}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Employees}"
                      SelectedItem="{Binding SelectedEmployee}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="180"/>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="140"/>
                    <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Карточка" Style="{StaticResource CardTitleStyle}"/>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="ФИО *" Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBox Text="{Binding Edit.FullName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="Роль *" Style="{StaticResource SecondaryTextStyle}"/>
                        <ComboBox ItemsSource="{Binding Roles}"
                                  SelectedValuePath="RoleID"
                                  DisplayMemberPath="RoleName"
                                  SelectedValue="{Binding Edit.RoleID}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6">
                        <TextBlock Text="Логин *" Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBox Text="{Binding Edit.Login, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="8">
                        <TextBlock Text="Новый пароль (если нужно)" Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBox Text="{Binding Edit.NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <CheckBox Grid.Row="10" Content="Активен"
                              IsChecked="{Binding Edit.IsActive}" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                Content="Новый" Command="{Binding NewCommand}"/>
                        <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                                Content="Сохранить" Command="{Binding SaveCommand}"/>
                        <Button Style="{StaticResource DangerButtonStyle}"
                                Content="Удалить" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
