<UserControl x:Class="PharmacyApp.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PharmacyApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Margin="0 0 20 0" Grid.Row="0" Text="Отчёты" Style="{StaticResource WindowTitleStyle}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Content="📊 Экспорт" Command="{Binding ExportSalesCommand}"/>
                <Button Style="{StaticResource IconButtonStyle}" 
                        Command="{Binding ExportSalesCommand}" ToolTip="Обновить">
                    <TextBlock Text="↻" FontSize="16" FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" Text="Период с"/>
                <DatePicker Grid.Column="2" SelectedDate="{Binding From}"/>

                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="по"/>
                <DatePicker Grid.Column="6" SelectedDate="{Binding To}"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="4" Margin="0,0,0,0" Background="Transparent" BorderThickness="0">
            <TabItem Header="Продажи за период">
                <Grid Margin="0,12,0,0">
                    <DataGrid ItemsSource="{Binding Sales}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding SaleID}" Width="70"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding SaleDate, StringFormat=g}" Width="160"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount}" Width="90"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding TotalQuantity}" Width="90"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalSum}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Остатки по категориям">
                <Grid Margin="0,12,0,0">
                    <DataGrid ItemsSource="{Binding InventoryByCategory}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="*"/>
                            <DataGridTextColumn Header="Уникальных товаров" Binding="{Binding UniqueDrugs}" Width="160"/>
                            <DataGridTextColumn Header="Остаток (шт.)" Binding="{Binding TotalQuantity}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Движение товара">
                <Grid Margin="0,12,0,0">
                    <DataGrid ItemsSource="{Binding Movement}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=g}" Width="160"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Sum}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>